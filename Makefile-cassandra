BIN      = mathSuite
CFLAGS   = $(INCS) -O2 -std=c99 -D_DEFAULT_SOURCE -D_GNU_SOURCE -DOPENSSL_SUPPRESS_DEPRECATED -qopenmp -D__USE_SQLITE
CXXFLAGS = $(INCS) -O2 -std=c++11 -D_DEFAULT_SOURCE -D_GNU_SOURCE -DOPENSSL_SUPPRESS_DEPRECATED -qopenmp -D__USE_SQLITE

vpath %.c . ExprEval jburkardt hashmap ExprEval/jburkardt

.PHONY: all all-before all-after clean clean-custom

all: all-before $(BIN) all-after

all-before:
	$(MKDIR) obj/Release

clean: clean-custom
	$(RM) $(OBJ) $(BIN)

$(BIN): $(LINKOBJ)
	$(CC) $(LINKOBJ) -o $(BIN) $(LIBS)

obj/Release/%.o: %.c
	$(CC) -c $< -o $@ $(CFLAGS)
