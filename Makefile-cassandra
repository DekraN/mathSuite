# Project: mathSuite
# Configurato per CMCC JUNO (RHEL 9.4 x86_64 - Intel OneAPI icc + SQLite3)

CC       = icx
CXX      = icpx
RM       = rm -f
MKDIR    = mkdir -p

# Rilevamento automatico flag per libxml2 e SQLite3 (Spack imposta anche CPATH e LIBRARY_PATH)
XML2_CFLAGS   := $(shell xml2-config --cflags 2>/dev/null || echo "-I/usr/include/libxml2")
XML2_LIBS     := $(shell xml2-config --libs 2>/dev/null || echo "-lxml2")

SQLITE_CFLAGS := $(shell pkg-config --cflags sqlite3 2>/dev/null)
SQLITE_LIBS   := $(shell pkg-config --libs sqlite3 2>/dev/null || echo "-lsqlite3")

INCS     = -Icompat -I. -I/usr/include $(XML2_CFLAGS) $(SQLITE_CFLAGS)
LIBS     = -lgmp -lmpfr $(XML2_LIBS) -lcrypto -lssl $(SQLITE_LIBS) -lm -qopenmp

